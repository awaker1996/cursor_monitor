{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "esModuleInterop": true,
    "declaration": false,
    "sourceMap": false,
    "noEmit": true
  },
  "include": [
    "electron/**/*",
    "src/core/**/*",
    "src/settings/**/*",
    "src/security/**/*",
    "src/shared/**/*",
    "src/utils/**/*"
  ]
}
